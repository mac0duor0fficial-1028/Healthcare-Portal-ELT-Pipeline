# --- Snowflake (shared) ---
SNOWFLAKE_ACCOUNT=xy12345.eu-central-1          # <org>-<account> or locator.region
SNOWFLAKE_WAREHOUSE=WH_ELT

# --- Loader service user (Python EL) ---
SNOWFLAKE_LOADER_USER=SVC_LOADER
SNOWFLAKE_LOADER_PRIVATE_KEY_PATH=/absolute/path/loader_key.p8
# SNOWFLAKE_LOADER_PRIVATE_KEY_PASSPHRASE=

# --- dbt service user ---
SNOWFLAKE_DBT_USER=SVC_DBT
SNOWFLAKE_DBT_PRIVATE_KEY_PATH=/absolute/path/dbt_key.p8
DBT_USER=yourname                                # dev schema becomes dbt_yourname

# --- Source API ---
API_BASE_URL=https://testprojectapi.gerasim.in/api/DoctorAppointment
